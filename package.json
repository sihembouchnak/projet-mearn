{
  "name": "budget-tracker-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "report": "node scripts/generate-report.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pdfkit": "^0.17.2"
  }
}
